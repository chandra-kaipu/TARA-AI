# ═══════════════════════════════════════════════════════════════════════════════
# TARA — AI Study & Productivity Agent Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# WAKE WORD PHONETIC REFERENCE:
# Keyword: TARA
# IPA: /ˈtɑːrə/
# Syllables: "TAH-rah"
# ARPAbet: T AA1 R AH0
# Used by the browser keyword-spotter and optional Porcupine/wake-word engines.
# ═══════════════════════════════════════════════════════════════════════════════

# SERVER CONFIGURATION
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ACTIVE LLM PROVIDER: "gemini" | "openai" | "anthropic" | "groq" | "ollama"
# If left blank or no key is provided, TARA runs in local extractive study mode.
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-1.5-flash

# 1. GOOGLE GEMINI (Recommended for fast, grounded multimodal study & agent)
# Get a key at: https://aistudio.google.com/
# Models: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
GEMINI_API_KEY=

# 2. OPENAI
# Get a key at: https://platform.openai.com/api-keys
# Models: gpt-4o, gpt-4o-mini
OPENAI_API_KEY=

# 3. ANTHROPIC (Claude)
# Get a key at: https://console.anthropic.com/
# Models: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
ANTHROPIC_API_KEY=

# 4. GROQ (Ultra-low latency inference)
# Get a free key at: https://console.groq.com/
# Models: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_API_KEY=

# 5. OLLAMA (100% Local / Offline LLM)
# Install from https://ollama.com/ and run: ollama run llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# VECTOR EMBEDDINGS PROVIDER: "local" (sentence-transformers, 0 keys needed) or "openai"
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# OPTIONAL PREMIUM VOICE SERVICES:
# Porcupine Wake Word Engine: https://console.picovoice.ai/ (If empty, browser Web Speech fallback is used)
PICOVOICE_ACCESS_KEY=

# ElevenLabs High-Quality TTS: https://elevenlabs.io/ (If empty, browser SpeechSynthesis is used)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Whisper STT API: Uses OPENAI_API_KEY if provided; otherwise Web Speech API handles STT in browser.
